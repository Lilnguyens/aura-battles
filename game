        function startP1GokuFlameLoop() {
            const video = document.getElementById('p1Video');
            const canvas = document.getElementById('p1Canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');

            const threshCanvas = document.createElement('canvas');
            threshCanvas.width = 160;
            threshCanvas.height = 120;
            const threshCtx = threshCanvas.getContext('2d');

            const flameParticles = Array.from({ length: 90 }, () => ({
                x: 0, y: 0,
                vx: (Math.random() - 0.5) * 3,
                vy: -Math.random() * 6 - 3,
                size: Math.random() * 6 + 3,
                life: Math.random() * 35
            }));

            function loop() {
                canvas.width = canvas.offsetWidth;
                canvas.height = canvas.offsetHeight;

                let motionVal = 0;

                ctx.save();
                ctx.translate(canvas.width, 0);
                ctx.scale(-1, 1);

                if (video && video.readyState === 4) {
                    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

                    threshCtx.drawImage(video, 0, 0, threshCanvas.width, threshCanvas.height);
                    const currentFrame = threshCtx.getImageData(0, 0, threshCanvas.width, threshCanvas.height);

                    if (p1PrevFrame) {
                        let diffSum = 0;
                        const len = currentFrame.data.length;
                        for (let i = 0; i < len; i += 16) {
                            const diff = Math.abs(currentFrame.data[i] - p1PrevFrame.data[i]) +
                                         Math.abs(currentFrame.data[i+1] - p1PrevFrame.data[i+1]) +
                                         Math.abs(currentFrame.data[i+2] - p1PrevFrame.data[i+2]);
                            if (diff > 50) diffSum++;
                        }
                        motionVal = Math.min(100, Math.floor((diffSum / (len / 16)) * 400));
                    }
                    p1PrevFrame = currentFrame;
                } else {
                    ctx.fillStyle = '#090d16';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);

                    const cx = canvas.width / 2;
                    const cy = canvas.height / 2;
                    ctx.fillStyle = '#1e293b';
                    ctx.beginPath();
                    ctx.arc(cx, cy - 25, 30, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.beginPath();
                    ctx.moveTo(cx - 40, cy + 60);
                    ctx.lineTo(cx, cy);
                    ctx.lineTo(cx + 40, cy + 60);
                    ctx.fill();

                    motionVal = Math.floor(Math.abs(Math.sin(Date.now() * 0.005)) * 60 + 20);
                }

                ctx.restore();

                p1State.energy = Math.floor(p1State.energy * 0.85 + motionVal * 0.15);
                const p1EnergyBar = document.getElementById('p1EnergyBar');
                if (p1EnergyBar) p1EnergyBar.style.width = `${p1State.energy}%`;

                const now = Date.now();
                if (matchActive && motionVal > 30 && (now - lastAutoMoveTime > 2000)) {
                    lastAutoMoveTime = now;
                    triggerAutoGesture(motionVal);
                }

                const aura = FLAME_AURAS.find(a => a.id === activeAuraId) || FLAME_AURAS[0];

                flameParticles.forEach(p => {
                    p.y += p.vy;
                    p.x += p.vx;
                    p.life++;

                    if (p.life > 35 || p.y < 0) {
                        p.x = (canvas.width * 0.25) + Math.random() * (canvas.width * 0.5);
                        p.y = canvas.height * 0.85;
                        p.vx = (Math.random() - 0.5) * 4;
                        p.vy = -Math.random() * 6 - 3;
                        p.life = 0;
                    }

                    ctx.save();
                    ctx.globalAlpha = (1 - p.life / 35) * 0.85;
                    ctx.fillStyle = aura.primary;
                    ctx.shadowBlur = 20;
                    ctx.shadowColor = aura.secondary;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                });

                requestAnimationFrame(loop);
            }

            loop();
        }

        function triggerAutoGesture(intensity) {
            let move;
            if (intensity > 75) move = MOVE_GUIDE.find(m => m.id === 'aura_charge') || MOVE_GUIDE[29];
            else if (intensity > 55) move = MOVE_GUIDE.find(m => m.id === 'suiii') || MOVE_GUIDE[23];
            else if (intensity > 40) move = MOVE_GUIDE.find(m => m.id === '67') || MOVE_GUIDE[0];
            else move = MOVE_GUIDE[Math.floor(Math.random() * MOVE_GUIDE.length)];

            let multiplier = 1;
            if (currentMode === 'duo' && p1State.energy > 50 && allyState.energy > 50) {
                multiplier = 2;
                spawnPopup(1, '2X TEAM COMBO!', 'text-cyan-300 font-black text-lg');
            } else if (currentMode === 'ranked') {
                multiplier = 1.5;
            }

            const earnedPts = Math.round(move.pts * multiplier);
            p1State.score += earnedPts;
            const p1Score = document.getElementById('p1Score');
            const p1LastMoveText = document.getElementById('p1LastMoveText');
            if (p1Score) p1Score.innerText = p1State.score;
            if (p1LastMoveText) p1LastMoveText.innerText = `${move.name.toUpperCase()} (+${earnedPts} AURA)`;

            spawnPopup(1, `+${earnedPts} ${move.name.toUpperCase()}`, 'text-amber-300 font-black text-base sm:text-lg drop-shadow-[0_0_10px_rgba(245,158,11,0.9)]');
            playSound('gesture');

            appendChatMessage('YOU', `[AUTOMATIC MOVE] ${move.name}! (+${earnedPts} Aura)`);
            updateTeamPowerBar();
        }

