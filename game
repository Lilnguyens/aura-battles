        function initAudio() {
            if (!audioCtx) {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (AudioCtx) audioCtx = new AudioCtx();
            }
        }

        function playSound(type) {
            if (!audioEnabled) return;
            initAudio();
            if (!audioCtx) return;

            try {
                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                if (type === 'gesture') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.exponentialRampToValueAtTime(880, now + 0.2);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
                    osc.start(now);
                    osc.stop(now + 0.2);
                } else if (type === 'matchFound') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, now);
                    osc.frequency.setValueAtTime(659.25, now + 0.1);
                    osc.frequency.setValueAtTime(783.99, now + 0.2);
                    gain.gain.setValueAtTime(0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
                    osc.start(now);
                    osc.stop(now + 0.35);
                }
            } catch (e) {
                // AudioContext policy catch
            }
        }

        function runCalibrationSequence() {
            const btn = document.getElementById('startCalibBtn');
            if (btn) {
                btn.disabled = true;
                btn.innerText = 'CALIBRATING CAMERA...';
            }

            navigator.mediaDevices.getUserMedia({ video: { width: 640, height: 480 }, audio: false })
            .then(stream => {
                const calibVideo = document.getElementById('calibVideo');
                if (calibVideo) calibVideo.srcObject = stream;
                p1Stream = stream;

                const stepCenter = document.getElementById('stepCenter');
                const calibPromptText = document.getElementById('calibPromptText');
                if (stepCenter) stepCenter.className = 'p-2 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500 font-bold';
                if (calibPromptText) calibPromptText.innerText = 'HOLD STILL IN CENTER...';

                setTimeout(() => {
                    const stepTurn = document.getElementById('stepTurn');
                    if (stepTurn) stepTurn.className = 'p-2 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500 font-bold';
                    if (calibPromptText) calibPromptText.innerText = 'TURN HEAD LEFT AND RIGHT...';

                    setTimeout(() => {
                        const stepBlink = document.getElementById('stepBlink');
                        if (stepBlink) stepBlink.className = 'p-2 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500 font-bold';
                        if (calibPromptText) calibPromptText.innerText = 'BLINK OR WAVE TO CAMERA!';

