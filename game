        function startP2Loop() {
            const canvas = document.getElementById('p2Canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const particles = Array.from({ length: 40 }, () => ({
                x: Math.random() * 400, y: Math.random() * 300,
                size: Math.random() * 4 + 2, speedY: Math.random() * 3 + 1, life: Math.random() * 50
            }));

            function loop() {
                if ((currentMode === 'duo' || currentMode === 'ranked') && !document.getElementById('duoExtraCardsGrid').classList.contains('grid')) return;
                canvas.width = canvas.offsetWidth;
                canvas.height = canvas.offsetHeight;

                ctx.fillStyle = '#090d16';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                const cx = canvas.width / 2;
                const cy = canvas.height / 2;
                ctx.fillStyle = '#1e293b';
                ctx.beginPath();
                ctx.arc(cx, cy - 25, 30, 0, Math.PI * 2);
                ctx.fill();
                ctx.beginPath();
                ctx.moveTo(cx - 40, cy + 60);
                ctx.lineTo(cx, cy);
                ctx.lineTo(cx + 40, cy + 60);
                ctx.fill();

                const simMotion = Math.floor(Math.abs(Math.sin(Date.now() * 0.004)) * 80 + 10);
                p2State.energy = simMotion;
                const p2EnergyBar = document.getElementById('p2EnergyBar');
                if (p2EnergyBar) p2EnergyBar.style.width = `${p2State.energy}%`;

                if (matchActive && simMotion > 50 && Math.random() < 0.08) {
                    p2State.score += 30;
                    const p2Score = document.getElementById('p2Score');
                    if (p2Score) p2Score.innerText = p2State.score;
                    spawnPopup(2, '+30 ENEMY AURA', 'text-fuchsia-400 font-bold text-sm');
                    updateTeamPowerBar();
                }

                particles.forEach(p => {
                    p.y -= p.speedY;
                    p.life++;
                    if (p.life > 50 || p.y < 0) {
                        p.x = Math.random() * canvas.width;
                        p.y = canvas.height + 10;
                        p.life = 0;
                    }
                    ctx.save();
                    ctx.globalAlpha = (1 - p.life / 50) * 0.8;
                    ctx.fillStyle = '#ec4899';
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.restore();
                });

                requestAnimationFrame(loop);
            }
            loop();
        }

