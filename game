        function startMatchTimer() {
            if (matchTimerInterval) clearInterval(matchTimerInterval);
            matchTimeRemaining = 30; // Strictly 30 seconds per game
            matchActive = true;
            inLobby = false;

            // Reveal arena & timer bar
            const arenaGrid = document.getElementById('battleArenaGrid');
            const duoGrid = document.getElementById('duoExtraCardsGrid');
            const timerBar = document.getElementById('matchTimerBarContainer');
            const powerBar = document.getElementById('teamPowerBarContainer');

            if (arenaGrid) arenaGrid.classList.remove('opacity-40', 'pointer-events-none');
            if (currentMode === 'duo' || currentMode === 'ranked') {
                if (duoGrid) duoGrid.classList.remove('opacity-40', 'pointer-events-none');
                if (powerBar) powerBar.classList.remove('hidden');
            }
            if (timerBar) timerBar.classList.remove('hidden');

            matchTimerInterval = setInterval(() => {
                if (!matchActive) return;
                matchTimeRemaining--;

                const timerText = document.getElementById('matchTimerText');
                const timerProgress = document.getElementById('matchTimerProgress');

                if (timerText) {
                    timerText.innerText = `00:${matchTimeRemaining < 10 ? '0' : ''}${matchTimeRemaining}`;
                }
                if (timerProgress) {
                    timerProgress.style.width = `${(matchTimeRemaining / 30) * 100}%`;
                }

                if (matchTimeRemaining <= 5 && matchTimeRemaining > 0) {
                    playSound('gesture');
                }

                if (matchTimeRemaining <= 0) {
                    clearInterval(matchTimerInterval);
                    matchActive = false;
                    triggerMatchEnd();
                }
            }, 1000);
        }

        function triggerMatchEnd() {
            const isWin = p1State.score >= p2State.score;
            const winnerModal = document.getElementById('winnerModal');
