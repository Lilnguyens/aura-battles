            for (let i = RANKED_TIERS.length - 1; i >= 0; i--) {
                if (rankedPoints >= RANKED_TIERS[i].minRp) {
                    currentTier = RANKED_TIERS[i];
                    nextTierMin = RANKED_TIERS[i+1] ? RANKED_TIERS[i+1].minRp : RANKED_TIERS[i].minRp + 500;
                    break;
                }
            }

            const prevMin = currentTier.minRp;
            const progress = Math.min(100, Math.max(0, ((rankedPoints - prevMin) / (nextTierMin - prevMin)) * 100));

            const rankedTierName = document.getElementById('rankedTierName');
            const rankedTierIcon = document.getElementById('rankedTierIcon');
            const rankedProgressText = document.getElementById('rankedProgressText');
            const rankedProgressBar = document.getElementById('rankedProgressBar');
            const winStreakCounter = document.getElementById('winStreakCounter');

            if (rankedTierName) rankedTierName.innerText = `${currentTier.name.toUpperCase()} (${rankedPoints} RP)`;
            if (rankedTierIcon) rankedTierIcon.className = `fa-solid ${currentTier.icon} text-xl`;
            if (rankedProgressText) rankedProgressText.innerText = `${rankedPoints} / ${nextTierMin} RP`;
            if (rankedProgressBar) rankedProgressBar.style.width = `${progress}%`;
