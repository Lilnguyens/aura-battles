        }

        function buyDiamondBundle(packId) {
            const bundle = DIAMOND_BUNDLES.find(b => b.id === packId);
            if (!bundle) return;
            if (userCash >= bundle.price) {
                userCash -= bundle.price;
                userDiamonds += bundle.diamonds;
                updateEconomyDisplays();
                renderShopContent();
                appendChatMessage('SYSTEM', `Successfully purchased ${bundle.diamonds.toLocaleString()} Diamonds for $${bundle.price.toFixed(2)}!`);
            } else {
                alert("Insufficient cash balance! Use the '+' button in the header to add test cash.");
            }
        }

        function buyTitleWithDiamonds(titleId) {
            const title = TITLES_CATALOG.find(t => t.id === titleId);
            if (!title) return;
            if (userDiamonds >= 100) {
                userDiamonds -= 100;
                title.unlocked = true;
                equipTitle(titleId);
                updateEconomyDisplays();
                renderShopContent();
                appendChatMessage('SYSTEM', `Unlocked title [${title.name.toUpperCase()}] for 100 Diamonds!`);
            } else {
                alert("Not enough Diamonds! Buy a Diamond bundle in the store.");
            }
        }

        function buyTitleWithCash(titleId) {
            const title = TITLES_CATALOG.find(t => t.id === titleId);
            if (!title) return;
            if (userCash >= 3.50) {
                userCash -= 3.50;
                title.unlocked = true;
                equipTitle(titleId);
                updateEconomyDisplays();
                renderShopContent();
                appendChatMessage('SYSTEM', `Unlocked title [${title.name.toUpperCase()}] for $3.50!`);
            } else {
                alert("Insufficient cash balance! Add test cash using the '+' button in the header.");
            }
        }

        function equipTitle(titleId) {
            const title = TITLES_CATALOG.find(t => t.id === titleId);
            if (!title || !title.unlocked) return;
            equippedTitleId = titleId;

            const p1EquippedTitleBadge = document.getElementById('p1EquippedTitleBadge');
            if (p1EquippedTitleBadge) p1EquippedTitleBadge.innerText = `[TITLE: ${title.name.toUpperCase()}]`;

            renderShopContent();
            appendChatMessage('SYSTEM', `Equipped title: [${title.name.toUpperCase()}]`);
        }

        function equipAura(auraId) {
            const aura = FLAME_AURAS.find(a => a.id === auraId);
            if (!aura) return;
            activeAuraId = auraId;

            const activeAuraBadge = document.getElementById('activeAuraBadge');
            if (activeAuraBadge) activeAuraBadge.innerText = aura.name.toUpperCase();

            renderShopContent();
            appendChatMessage('SYSTEM', `Equipped Goku Flame Aura: ${aura.name}`);
        }

        function renderMoveGuideList() {
            const container = document.getElementById('moveGuideList');
            if (!container) return;
            container.innerHTML = '';

            MOVE_GUIDE.forEach(m => {
                const item = document.createElement('div');
                item.className = 'bg-slate-950 p-2 rounded-xl border border-slate-800 flex items-center gap-2';
                item.innerHTML = `
                    <div class="p-1.5 bg-amber-500/20 text-amber-400 rounded-lg"><i class="fa-solid ${m.icon} text-xs"></i></div>
                    <div class="overflow-hidden">
                        <div class="font-orbitron font-bold text-[11px] text-white truncate">${m.name}</div>
                        <div class="text-[9px] font-mono text-cyan-400">+${m.pts} PTS</div>
                    </div>
                `;
                container.appendChild(item);
            });
        }

        function appendChatMessage(sender, text) {
            const box = document.getElementById('chatMessagesBox');
            if (!box) return;
            const div = document.createElement('div');
            div.innerHTML = `<span class="text-amber-400 font-bold">[${sender}]:</span> <span class="text-slate-300">${text}</span>`;
            box.appendChild(div);
            box.scrollTop = box.scrollHeight;
        }

        function handleSendChat(event) {
            event.preventDefault();
            const input = document.getElementById('chatInput');
            if (!input) return;
            const val = input.value.trim();
            if (!val) return;

            appendChatMessage('YOU', val);
            input.value = '';

            setTimeout(() => {
                const botReplies = [
                    "Absolute maxing aura! 🔥",
                    "You can't match my Super Saiyan flame!",
                    "Bro is glowing like Goku UI!",
                    "GGs in the chat!"
                ];
                const reply = botReplies[Math.floor(Math.random() * botReplies.length)];
                const p2NameTag = document.getElementById('p2NameTag');
                appendChatMessage(p2NameTag ? p2NameTag.innerText : 'OPPONENT', reply);
            }, 1000);
        }
    </script>
</body>
</html>
