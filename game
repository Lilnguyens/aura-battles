        function updateTeamPowerBar() {
            if (currentMode !== 'duo' && currentMode !== 'ranked') return;
            const alphaTotal = p1State.score + allyState.score;
            const omegaTotal = p2State.score + enemy2State.score;
            const sum = alphaTotal + omegaTotal || 1;
            const alphaPct = Math.round((alphaTotal / sum) * 100);
            const omegaPct = 100 - alphaPct;

            const teamAlphaBar = document.getElementById('teamAlphaBar');
            const teamOmegaBar = document.getElementById('teamOmegaBar');
