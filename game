<!DOCTYPE html>
<html lang="en">
<head>
<meta name="google-site-verification" content="T676GznQ04ohth-" />
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aura Battle Roulette & Goku Flame Aura Engine</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@600;700;900&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Rajdhani', sans-serif;
            background-color: #030712;
            color: #f3f4f6;
            overflow-x: hidden;
            user-select: none;
        }
        .font-orbitron {
            font-family: 'Orbitron', sans-serif;
        }

        @keyframes gokuPopup {
            0% { transform: translateY(0) scale(0.6) rotate(-8deg); opacity: 0; }
            20% { transform: translateY(-25px) scale(1.3) rotate(4deg); opacity: 1; }
            80% { transform: translateY(-75px) scale(1.1) rotate(-2deg); opacity: 1; }
            100% { transform: translateY(-120px) scale(0.8) rotate(0deg); opacity: 0; }
        }
        .animate-goku-popup {
            animation: gokuPopup 1.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes saiyanFlamePulse {
            0%, 100% {
                border-color: rgba(245, 158, 11, 0.8);
                box-shadow: 0 0 25px rgba(245, 158, 11, 0.5), inset 0 0 15px rgba(245, 158, 11, 0.25);
            }
            50% {
                border-color: rgba(239, 68, 68, 0.9);
                box-shadow: 0 0 45px rgba(239, 68, 68, 0.7), inset 0 0 25px rgba(239, 68, 68, 0.35);
            }
        }
        .saiyan-flame-border {
            animation: saiyanFlamePulse 2s infinite ease-in-out;
        }

        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.9);
        }
        ::-webkit-scrollbar-thumb {
            background: #f59e0b;
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-slate-950 text-slate-100 relative">

    <header class="relative z-30 w-full px-4 py-3 border-b border-slate-800 bg-slate-900/95 backdrop-blur-md flex flex-wrap justify-between items-center gap-3 shadow-2xl">
        <div class="flex items-center gap-3">
            <div class="p-2.5 bg-gradient-to-tr from-amber-500 via-rose-600 to-fuchsia-600 rounded-xl shadow-lg shadow-amber-500/30 animate-pulse">
                <i class="fa-solid fa-fire text-2xl text-slate-950"></i>
            </div>
            <div>
                <h1 class="font-orbitron font-black text-xl sm:text-2xl tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-rose-400 to-fuchsia-400">
                    AURA BATTLE ROULETTE
                </h1>
                <p class="text-[10px] sm:text-xs text-slate-400 font-mono tracking-widest flex items-center gap-1.5">
                    <span class="inline-block w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
                    GOKU FLAME AURA • 2V2 TEAM DUO • DIAMOND ECONOMY
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3 flex-wrap">
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-950 border border-cyan-500/50 text-xs font-mono shadow-inner">
                <i class="fa-solid fa-gem text-cyan-400 animate-bounce"></i>
                <span class="text-slate-400">DIAMONDS:</span>
                <span id="diamondBalance" class="text-cyan-400 font-bold font-orbitron text-sm">1,000</span>
            </div>

            <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-950 border border-emerald-500/50 text-xs font-mono shadow-inner">
                <i class="fa-solid fa-wallet text-emerald-400"></i>
                <span class="text-slate-400">CASH:</span>
                <span id="cashBalance" class="text-emerald-400 font-bold font-orbitron text-sm">$10.00</span>
                <button onclick="topUpTestCash()" title="Add $5 test cash" class="ml-1 text-[10px] bg-emerald-500/20 text-emerald-300 hover:bg-emerald-500/40 px-1.5 py-0.5 rounded border border-emerald-500/40 transition">+</button>
            </div>

            <button onclick="openShopModal()" class="px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 via-rose-600 to-fuchsia-600 hover:from-amber-400 hover:to-fuchsia-500 text-slate-950 font-orbitron font-black text-xs sm:text-sm shadow-lg shadow-amber-500/20 transition transform hover:scale-105 active:scale-95 flex items-center gap-2">
                <i class="fa-solid fa-store"></i>
                <span>SHOP & TITLES</span>
            </button>

            <button id="soundToggleBtn" onclick="toggleAudio()" class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-amber-400 transition text-xs font-mono flex items-center gap-1.5">
                <i id="soundIcon" class="fa-solid fa-volume-high"></i>
                <span id="soundText" class="hidden sm:inline">SFX ON</span>
            </button>
        </div>
    </header>

    <div id="calibrationModal" class="fixed inset-0 z-50 bg-slate-950/95 backdrop-blur-xl flex items-center justify-center p-4">
        <div class="bg-slate-900 border-2 border-amber-500/70 rounded-3xl max-w-lg w-full p-6 shadow-2xl relative text-center">
            <div class="mb-4">
                <div class="inline-block p-3 rounded-2xl bg-amber-500/20 text-amber-400 border border-amber-500/40 mb-2">
                    <i class="fa-solid fa-camera-rotate text-3xl"></i>
                </div>
                <h2 class="font-orbitron font-black text-xl text-white">CAMERA CHECK & CALIBRATION</h2>
                <p class="text-xs text-slate-400 font-mono mt-1">Verify face positioning & head motion before entering battle</p>
            </div>

            <div class="mb-4 text-left">
                <label class="block text-xs font-mono text-slate-400 mb-1">YOUR FIGHTER NICKNAME:</label>
                <input type="text" id="playerNameInput" value="SIGMA_WARRIOR" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white font-mono focus:border-amber-400 focus:outline-none">
            </div>

            <div class="relative w-full h-48 bg-slate-950 rounded-2xl border border-slate-800 overflow-hidden mb-4 flex items-center justify-center">
                <video id="calibVideo" class="w-full h-full object-cover transform -scale-x-100" autoplay playsinline muted></video>
                <div id="calibOverlay" class="absolute inset-0 border-2 border-dashed border-amber-400/60 rounded-2xl pointer-events-none flex items-center justify-center">
                    <span id="calibPromptText" class="bg-slate-950/80 px-3 py-1 rounded-lg text-xs font-mono text-amber-300 font-bold border border-amber-500/40">ALIGN FACE IN CENTER</span>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-2 mb-5 font-mono text-[10px]">
                <div id="stepCenter" class="p-2 rounded-xl bg-slate-950 border border-slate-800 text-slate-500 font-bold">1. FACE CENTER</div>
                <div id="stepTurn" class="p-2 rounded-xl bg-slate-950 border border-slate-800 text-slate-500 font-bold">2. TURN HEAD</div>
                <div id="stepBlink" class="p-2 rounded-xl bg-slate-950 border border-slate-800 text-slate-500 font-bold">3. BLINK / WAVE</div>
            </div>

            <button id="startCalibBtn" onclick="runCalibrationSequence()" class="w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-rose-600 hover:from-amber-400 hover:to-rose-500 text-slate-950 font-orbitron font-black text-sm shadow-lg shadow-amber-500/30 transition transform hover:scale-102">
                START CAMERA CHECK
            </button>
        </div>
    </div>

    <main class="relative z-10 container mx-auto px-2 sm:px-4 py-3 flex-grow flex flex-col justify-between max-w-7xl gap-3">

        <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-3 flex flex-wrap justify-between items-center gap-3 shadow-xl backdrop-blur-md">
            <div class="flex items-center gap-2 flex-wrap">
                <button id="tabPvp" onclick="switchMode('pvp')" class="px-4 py-2 rounded-xl font-orbitron font-bold text-xs bg-amber-500 text-slate-950 shadow-md">
                    <i class="fa-solid fa-bolt mr-1"></i> 1v1 PvP ROULETTE
                </button>
                <button id="tabDuo" onclick="switchMode('duo')" class="px-4 py-2 rounded-xl font-orbitron font-bold text-xs bg-slate-800 text-slate-300 hover:bg-slate-700">
                    <i class="fa-solid fa-users mr-1"></i> 2v2 DUO TEAM BATTLE
                </button>
                <button id="tabRanked" onclick="switchMode('ranked')" class="px-4 py-2 rounded-xl font-orbitron font-bold text-xs bg-slate-800 text-slate-300 hover:bg-slate-700">
                    <i class="fa-solid fa-trophy mr-1"></i> RANKED COMPETITIVE
                </button>
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button id="startSearchBtn" onclick="startMatchmaking()" class="flex-1 sm:flex-initial px-5 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 font-orbitron font-black text-xs shadow-lg shadow-emerald-500/25 transition">
                    <i class="fa-solid fa-play mr-1"></i> START SEARCHING
                </button>
                <button id="skipMatchBtn" onclick="skipMatch()" class="flex-1 sm:flex-initial px-5 py-2 rounded-xl bg-gradient-to-r from-rose-600 to-fuchsia-600 hover:from-rose-500 hover:to-fuchsia-500 text-white font-orbitron font-black text-xs shadow-lg shadow-rose-500/25 transition">
                    <i class="fa-solid fa-forward mr-1"></i> SKIP / NEXT [ESC]
                </button>
            </div>
        </div>

        <div id="teamPowerBarContainer" class="hidden bg-slate-900/90 border border-slate-800 rounded-2xl p-3 shadow-xl backdrop-blur-md">
            <div class="flex justify-between items-center mb-1 text-xs font-orbitron font-bold">
                <span class="text-cyan-400">TEAM ALPHA (YOU & ALLY)</span>
                <span class="text-amber-400" id="teamScoreRatio">50% vs 50%</span>
                <span class="text-rose-400">TEAM OMEGA (ENEMIES)</span>
            </div>
            <div class="w-full h-3 bg-slate-950 rounded-full border border-slate-700 overflow-hidden flex">
                <div id="teamAlphaBar" class="h-full bg-cyan-500 transition-all duration-300" style="width: 50%;"></div>
                <div id="teamOmegaBar" class="h-full bg-rose-500 transition-all duration-300" style="width: 50%;"></div>
            </div>
        </div>

        <div id="rankedStatusBarContainer" class="hidden bg-slate-900/90 border border-slate-800 rounded-2xl p-3 shadow-xl backdrop-blur-md flex flex-wrap justify-between items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-amber-500/20 border border-amber-500/50 rounded-xl text-amber-400">
                    <i id="rankedTierIcon" class="fa-solid fa-shield-halved text-xl"></i>
                </div>
                <div>
                    <span class="text-[10px] font-mono text-slate-400 block">RANKED TIER</span>
                    <span id="rankedTierName" class="font-orbitron font-black text-sm text-amber-400">BRONZE I (1,200 RP)</span>
                </div>
            </div>

            <div class="flex-grow max-w-md mx-4">
                <div class="flex justify-between text-[10px] font-mono text-slate-400 mb-1">
                    <span>PROGRESS TO NEXT TIER</span>
                    <span id="rankedProgressText">120 / 300 RP</span>
                </div>
                <div class="w-full h-2.5 bg-slate-950 rounded-full border border-slate-700 overflow-hidden">
                    <div id="rankedProgressBar" class="h-full bg-gradient-to-r from-amber-500 to-rose-500 transition-all duration-300" style="width: 40%;"></div>
                </div>
            </div>

            <div class="flex items-center gap-2 text-xs font-mono">
                <span class="text-slate-400">STREAK:</span>
                <span id="winStreakCounter" class="text-emerald-400 font-bold font-orbitron">0 WIN STREAK</span>
            </div>
        </div>

        <!-- 30-Second Countdown Timer Bar -->
        <div id="matchTimerBarContainer" class="bg-slate-900/90 border border-amber-500/50 rounded-2xl px-4 py-2 flex justify-between items-center shadow-xl backdrop-blur-md">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-stopwatch text-amber-400 animate-pulse"></i>
                <span class="font-orbitron font-bold text-xs text-amber-300">MATCH CLOCK:</span>
            </div>
            <div class="flex items-center gap-3">
                <span id="matchTimerText" class="font-orbitron font-black text-lg text-amber-400">00:30</span>
                <div class="w-36 h-2 bg-slate-950 rounded-full border border-slate-700 overflow-hidden">
                    <div id="matchTimerProgress" class="h-full bg-amber-500 transition-all duration-1000" style="width: 100%;"></div>
                </div>
            </div>
        </div>

        <div id="battleArenaGrid" class="grid grid-cols-1 lg:grid-cols-2 gap-3 flex-grow items-stretch">
            
            <div id="p1Card" class="bg-slate-900/80 border-2 border-amber-500/60 rounded-2xl p-3 backdrop-blur-xl relative flex flex-col justify-between shadow-2xl saiyan-flame-border">
                <div>
                    <div class="flex justify-between items-center mb-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping"></span>
                                <h3 id="p1NameTag" class="font-orbitron font-black text-sm sm:text-base text-amber-400">YOU (SIGMA_WARRIOR)</h3>
                            </div>
                            <span id="p1EquippedTitleBadge" class="inline-block mt-0.5 text-[10px] font-orbitron font-extrabold px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/50 uppercase shadow-sm">
                                [TITLE: MOGGER]
                            </span>
                        </div>
                        <div class="text-right">
                            <span class="text-[10px] font-mono text-slate-400 block">FLAME AURA</span>
                            <span id="activeAuraBadge" class="text-xs font-mono font-bold text-amber-400 uppercase">SUPER SAIYAN GOLD</span>
                        </div>
                    </div>

                    <div class="relative w-full h-60 sm:h-72 md:h-80 bg-slate-950 rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center">
                        <video id="p1Video" class="hidden" autoplay playsinline muted></video>
                        <canvas id="p1Canvas" class="w-full h-full object-cover rounded-xl"></canvas>
                        <div id="p1PopupContainer" class="absolute inset-0 pointer-events-none overflow-hidden"></div>
                        <div class="absolute bottom-2 left-2 right-2 bg-slate-950/85 backdrop-blur-md p-2 rounded-lg border border-slate-800 flex items-center gap-2">
                            <span class="text-[10px] font-mono text-slate-400 whitespace-nowrap">AURA BURST</span>
                            <div class="w-full h-2.5 bg-slate-900 rounded-full border border-slate-700 overflow-hidden">
                                <div id="p1EnergyBar" class="h-full bg-gradient-to-r from-amber-500 via-rose-500 to-fuchsia-500 rounded-full transition-all duration-100 w-0"></div>
                            </div>
                            <span id="p1Score" class="font-orbitron font-black text-sm text-amber-400 ml-1">0</span>
                        </div>
                    </div>
                </div>

                <div class="mt-2 flex justify-between items-center bg-slate-950/70 p-2 rounded-xl border border-slate-800">
                    <span class="text-[10px] font-mono text-slate-400">DETECTED MOTION:</span>
                    <span id="p1LastMoveText" class="font-orbitron font-extrabold text-xs text-amber-300">MOVE IN FRONT OF CAMERA</span>
                </div>
            </div>

            <div id="p2Card" class="bg-slate-900/80 border-2 border-fuchsia-500/60 rounded-2xl p-3 backdrop-blur-xl relative flex flex-col justify-between shadow-2xl">
                <div>
                    <div class="flex justify-between items-center mb-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <span id="p2StatusDot" class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
                                <h3 id="p2NameTag" class="font-orbitron font-black text-sm sm:text-base text-fuchsia-400">SEARCHING...</h3>
                            </div>
                            <span id="p2EquippedTitleBadge" class="inline-block mt-0.5 text-[10px] font-orbitron font-extrabold px-2 py-0.5 rounded bg-fuchsia-500/20 text-fuchsia-300 border border-fuchsia-500/50 uppercase shadow-sm">
                                [TITLE: UNKNOWN]
                            </span>
                        </div>
                        <div class="text-right">
                            <span class="text-[10px] font-mono text-slate-400 block">OPPONENT AURA</span>
                            <span id="p2Score" class="font-orbitron font-black text-sm sm:text-base text-amber-400">0</span>
                        </div>
                    </div>

                    <div class="relative w-full h-60 sm:h-72 md:h-80 bg-slate-950 rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center">
                        <video id="p2Video" class="hidden" autoplay playsinline></video>
                        <canvas id="p2Canvas" class="w-full h-full object-cover rounded-xl"></canvas>

                        <div id="p2LoadingOverlay" class="absolute inset-0 bg-slate-950/90 flex flex-col items-center justify-center p-6 text-center z-20">
                            <div class="p-4 rounded-full bg-slate-900 border border-fuchsia-500/40 animate-spin mb-3">
                                <i class="fa-solid fa-spinner text-3xl text-fuchsia-400"></i>
                            </div>
                            <h4 id="searchingTitleText" class="font-orbitron font-bold text-sm text-white">SEARCHING FOR OPPONENT</h4>
                            <p class="text-xs text-slate-400 mt-1 max-w-xs">Connecting to live 1v1 video battlers...</p>
                        </div>

                        <div id="p2PopupContainer" class="absolute inset-0 pointer-events-none overflow-hidden"></div>

                        <div class="absolute bottom-2 left-2 right-2 bg-slate-950/85 backdrop-blur-md p-2 rounded-lg border border-slate-800 flex items-center gap-2">
                            <span class="text-[10px] font-mono text-slate-400 whitespace-nowrap">AURA BURST</span>
                            <div class="w-full h-2.5 bg-slate-900 rounded-full border border-slate-700 overflow-hidden">
                                <div id="p2EnergyBar" class="h-full bg-gradient-to-r from-fuchsia-500 via-rose-500 to-amber-400 rounded-full transition-all duration-100 w-0"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-2 flex justify-between items-center bg-slate-950/70 p-2 rounded-xl border border-slate-800">
                    <span class="text-[10px] font-mono text-slate-400">JUDGING EVALUATION:</span>
                    <span id="p2RankTag" class="text-[10px] font-mono px-2 py-0.5 rounded bg-fuchsia-950 text-fuchsia-300 border border-fuchsia-800 font-bold uppercase">CONNECTING...</span>
                </div>
            </div>

        </div>

        <div id="duoExtraCardsGrid" class="hidden grid grid-cols-1 lg:grid-cols-2 gap-3">
            <div id="allyCard" class="bg-slate-900/80 border-2 border-cyan-500/60 rounded-2xl p-3 backdrop-blur-xl relative flex flex-col justify-between shadow-2xl">
                <div>
                    <div class="flex justify-between items-center mb-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
                                <h3 id="allyNameTag" class="font-orbitron font-black text-sm sm:text-base text-cyan-400">ALLY (CYBER_DUO)</h3>
                            </div>
                            <span id="allyEquippedTitleBadge" class="inline-block mt-0.5 text-[10px] font-orbitron font-extrabold px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/50 uppercase shadow-sm">
                                [TITLE: RIZZLER PRIME]
                            </span>
                        </div>
                        <div class="text-right">
                            <span class="text-[10px] font-mono text-slate-400 block">ALLY AURA</span>
                            <span id="allyScore" class="font-orbitron font-black text-sm sm:text-base text-cyan-400">0</span>
                        </div>
                    </div>
                    <div class="relative w-full h-40 bg-slate-950 rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center">
                        <canvas id="allyCanvas" class="w-full h-full object-cover rounded-xl"></canvas>
                        <div class="absolute bottom-2 left-2 right-2 bg-slate-950/85 backdrop-blur-md p-1.5 rounded-lg border border-slate-800 flex items-center gap-2">
                            <span class="text-[10px] font-mono text-slate-400 whitespace-nowrap">SYNERGY</span>
                            <div class="w-full h-2 bg-slate-900 rounded-full border border-slate-700 overflow-hidden">
                                <div id="allyEnergyBar" class="h-full bg-cyan-400 rounded-full w-0"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-2 flex justify-between items-center bg-slate-950/70 p-2 rounded-xl border border-slate-800">
                    <span class="text-[10px] font-mono text-slate-400">TEAM STATUS:</span>
                    <span class="text-[10px] font-mono text-cyan-300 font-bold">2X COMBO SYNERGY ACTIVE</span>
                </div>
            </div>

            <div id="enemy2Card" class="bg-slate-900/80 border-2 border-rose-500/60 rounded-2xl p-3 backdrop-blur-xl relative flex flex-col justify-between shadow-2xl">
                <div>
                    <div class="flex justify-between items-center mb-2">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                                <h3 id="enemy2NameTag" class="font-orbitron font-black text-sm sm:text-base text-rose-400">OPPONENT 2</h3>
                            </div>
                            <span id="enemy2EquippedTitleBadge" class="inline-block mt-0.5 text-[10px] font-orbitron font-extrabold px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/50 uppercase shadow-sm">
                                [TITLE: VOID REAPER]
                            </span>
                        </div>
                        <div class="text-right">
                            <span class="text-[10px] font-mono text-slate-400 block">ENEMY AURA</span>
                            <span id="enemy2Score" class="font-orbitron font-black text-sm sm:text-base text-rose-400">0</span>
                        </div>
                    </div>
                    <div class="relative w-full h-40 bg-slate-950 rounded-xl overflow-hidden border border-slate-800 flex items-center justify-center">
                        <canvas id="enemy2Canvas" class="w-full h-full object-cover rounded-xl"></canvas>
                        <div class="absolute bottom-2 left-2 right-2 bg-slate-950/85 backdrop-blur-md p-1.5 rounded-lg border border-slate-800 flex items-center gap-2">
                            <span class="text-[10px] font-mono text-slate-400 whitespace-nowrap">AURA BURST</span>
                            <div class="w-full h-2 bg-slate-900 rounded-full border border-slate-700 overflow-hidden">
                                <div id="enemy2EnergyBar" class="h-full bg-rose-500 rounded-full w-0"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-2 flex justify-between items-center bg-slate-950/70 p-2 rounded-xl border border-slate-800">
                    <span class="text-[10px] font-mono text-slate-400">THREAT LEVEL:</span>
                    <span class="text-[10px] font-mono text-rose-400 font-bold uppercase">EXTREME</span>
                </div>
