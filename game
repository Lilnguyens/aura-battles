            const finalRewardText = document.getElementById('finalRewardText');

            if (winnerText) winnerText.innerText = isWin ? 'VICTORY!' : 'DEFEAT!';
            if (winnerSubText) winnerSubText.innerText = isWin ? 'You dominated the 30-second aura battle!' : 'Opponent out-flexed your aura!';
            if (winnerIconBadge) winnerIconBadge.className = isWin ? 'inline-block p-4 rounded-2xl bg-amber-500/20 text-amber-400 border border-amber-500/50 mb-3 animate-bounce' : 'inline-block p-4 rounded-2xl bg-rose-500/20 text-rose-400 border border-rose-500/50 mb-3';
            if (finalP1Score) finalP1Score.innerText = p1State.score;
            if (finalP2Score) finalP2Score.innerText = p2State.score;

            const reward = isWin ? 500 : 150;
            userDiamonds += reward;
            if (finalRewardText) finalRewardText.innerText = `+${reward} 💎`;
            updateEconomyDisplays();

            if (currentMode === 'ranked') {
                if (isWin) {
                    rankedPoints += 50;
                    winStreak++;
                } else {
                    rankedPoints = Math.max(0, rankedPoints - 30);
                    winStreak = 0;
                }
                updateRankedUI();
            }

            if (winnerModal) winnerModal.classList.remove('hidden');
            appendChatMessage('SYSTEM', `Match ended! Winner: ${isWin ? 'YOU' : 'OPPONENT'}. Awarded +${reward} Diamonds.`);
        }

